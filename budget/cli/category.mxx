module;

#include <algorithm>
#include <chrono>
#include <cstdint>
#include <iostream>
#include <optional>
#include <string>
#include <string_view>

#include <CLI/CLI.hpp>

export module budget.cli:category;

import budget.application;
import :month_value;

export namespace budget::cli::category
{
struct category_options
{
    std::string name;
    std::string month;
    std::uint32_t allocated{};
    std::uint64_t id{};
    bool force{};
    int exit_code{};
};

void add_category_commands(CLI::App &app, category_options &command_options,
                           budget::application::book_repository &repository)
{
    auto *category_command = app.add_subcommand("category", "Manage budget categories");

    auto *create_command = category_command->add_subcommand("create", "Create a category in a budget month");
    create_command->add_option("name", command_options.name, "Category name")->required();
    create_command->add_option("--month", command_options.month, "Budget month in YYYY-MM format")->required();
    create_command->add_option("--allocated", command_options.allocated, "Allocated whole-number amount");

    auto *list_command = category_command->add_subcommand("list", "List categories in a budget month");
    auto *list_month_option =
        list_command->add_option("--month", command_options.month, "Budget month in YYYY-MM format");
    list_month_option->required();

    auto *remove_command = category_command->add_subcommand("remove", "Remove a category from a budget month");
    remove_command->add_option("id", command_options.id, "Category ID")->required();
    auto *remove_month_option =
        remove_command->add_option("--month", command_options.month, "Budget month in YYYY-MM format");
    remove_month_option->required();
    remove_command->add_flag("--force", command_options.force,
                             "Remove the category and its items, clearing transaction references");

    const auto parse_month_option =
        [&command_options](const std::string &value,
                           std::string_view option_name) -> std::optional<std::chrono::year_month> {
        const auto parsed_month = budget::cli::month_value::parse(value);
        if (!parsed_month)
        {
            std::cerr << "Invalid month '" << value << "'. Expected a valid YYYY-MM month for " << option_name << ".\n";
            command_options.exit_code = 2;
            return std::nullopt;
        }
        return parsed_month;
    };

    create_command->callback([&command_options, &repository, parse_month_option] {
        const auto requested_month = parse_month_option(command_options.month, "--month");
        if (!requested_month)
        {
            return;
        }

        const auto result = budget::application::create_category(
            repository,
            {.year_month = *requested_month, .name = command_options.name, .allocated = command_options.allocated});
        if (!result)
        {
            switch (result.error())
            {
            case budget::application::create_category_error::month_not_found:
                std::cerr << "Budget month " << budget::cli::month_value::format(*requested_month)
                          << " was not found.\n";
                command_options.exit_code = 1;
                return;
            case budget::application::create_category_error::invalid_name:
                std::cerr << "Category name must not be empty or whitespace only.\n";
                command_options.exit_code = 2;
                return;
            case budget::application::create_category_error::duplicate_name:
                std::cerr << "A category with that name already exists in budget month "
                          << budget::cli::month_value::format(*requested_month) << ".\n";
                command_options.exit_code = 1;
                return;

            }
        }

        std::cout << "Created category " << *result << " for " << budget::cli::month_value::format(*requested_month)
                  << ".\n";
    });

    list_command->callback([&command_options, &repository, parse_month_option] {
        const auto requested_month = parse_month_option(command_options.month, "--month");
        if (!requested_month)
        {
            return;
        }

        const auto result = budget::application::list_categories(repository, {.year_month = *requested_month});
        if (!result)
        {
            switch (result.error())
            {
            case budget::application::list_categories_error::month_not_found:
                std::cerr << "Budget month " << budget::cli::month_value::format(*requested_month)
                          << " was not found.\n";
                command_options.exit_code = 1;
                return;

            }
        }

        const auto &categories = result->categories;
        if (categories.empty())
        {
            std::cout << "No categories found for " << budget::cli::month_value::format(*requested_month) << ".\n";
            return;
        }

        std::cout << "ID | NAME | ALLOCATED\n";
        std::ranges::for_each(categories, [&result](const auto &category) {
            const auto budget = std::ranges::find_if(result->budgets, [&category](const auto &entry) {
                return entry.period_id == category.period_id && entry.category_id == category.id;
            });
            if (budget != result->budgets.end())
            {
                std::cout << category.id << " | " << category.name << " | " << budget->allocated << '\n';
            }
        });
    });

    remove_command->callback([&command_options, &repository, parse_month_option] {
        const auto requested_month = parse_month_option(command_options.month, "--month");
        if (!requested_month)
        {
            return;
        }

        const auto result = budget::application::remove_category(
            repository,
            {.year_month = *requested_month, .category_id = command_options.id, .force = command_options.force});
        if (!result)
        {
            switch (result.error())
            {
            case budget::application::remove_category_error::month_not_found:
                std::cerr << "Budget month " << budget::cli::month_value::format(*requested_month)
                          << " was not found.\n";
                command_options.exit_code = 1;
                return;
            case budget::application::remove_category_error::not_found:
                std::cerr << "Category " << command_options.id << " was not found in budget month "
                          << budget::cli::month_value::format(*requested_month) << ".\n";
                command_options.exit_code = 1;
                return;
            case budget::application::remove_category_error::in_use:
                std::cerr << "Category " << command_options.id
                          << " is in use. Use --force to remove it and its items.\n";
                command_options.exit_code = 1;
                return;

            }
        }

        std::cout << "Removed category " << command_options.id << " from "
                  << budget::cli::month_value::format(*requested_month) << ".\n";
    });
}
} // namespace budget::cli::category
