module;

#include <algorithm>
#include <chrono>
#include <expected>

#include <optional>
#include <string>
#include <string_view>
#include <vector>

export module budget.core:month;

import :types;

export namespace budget
{
class month
{
  public:
    explicit month(budget::types::period period) : period_(period)
    {
    }

    [[nodiscard]]
    auto create_category(std::string_view name, budget::types::amount allocated = 0)
        -> std::expected<budget::types::category_id, budget::types::category_error>
    {
        if (std::ranges::any_of(categories_, [name](const auto &category) { return category.name == name; }))
        {
            return std::unexpected{budget::types::category_error::duplicate_name};
        }

        const auto new_category_id = category_id_ + 1;

        categories_.push_back(budget::types::category{
            .id = new_category_id,
            .period_id = period_.id,
            .name = std::string{name},
        });
        try
        {
            category_budgets_.push_back(budget::types::category_budget{
                .category_id = new_category_id,
                .period_id = period_.id,
                .allocated = allocated,
            });
        }
        catch (...)
        {
            categories_.pop_back();
            throw;
        }

        category_id_ = new_category_id;
        return category_id_;
    }


    [[nodiscard]]
    auto remove_category(budget::types::category_id category_id, bool force = false)
        -> std::expected<void, budget::types::category_error>
    {
        const auto category = std::ranges::find(categories_, category_id, &budget::types::category::id);
        if (category == categories_.end())
        {
            return std::unexpected{budget::types::category_error::not_found};
        }

        const auto has_items = std::ranges::any_of(
            items_, [category_id](const auto &item) { return item.category_id == category_id; });
        const auto transaction_references_category = std::ranges::any_of(transactions_, [this, category_id](const auto &transaction) {
            return (transaction.category_id && *transaction.category_id == category_id) ||
                   (transaction.item_id && std::ranges::any_of(items_, [&transaction, category_id](const auto &item) {
                        return item.category_id == category_id && item.id == *transaction.item_id;
                    }));
        });

        if ((has_items || transaction_references_category) && !force)
        {
            return std::unexpected{budget::types::category_error::in_use};
        }

        if (force)
        {
            std::ranges::for_each(transactions_, [this, category_id](auto &transaction) {
                if (transaction.category_id && *transaction.category_id == category_id)
                {
                    transaction.category_id.reset();
                }
                if (transaction.item_id && std::ranges::any_of(items_, [&transaction, category_id](const auto &item) {
                        return item.category_id == category_id && item.id == *transaction.item_id;
                    }))
                {
                    transaction.item_id.reset();
                }
            });

            const auto removed_items = std::ranges::remove_if(
                items_, [category_id](const auto &item) { return item.category_id == category_id; });
            items_.erase(removed_items.begin(), removed_items.end());
        }


        const auto removed_budgets = std::ranges::remove_if(
            category_budgets_, [category_id](const auto &budget) { return budget.category_id == category_id; });
        category_budgets_.erase(removed_budgets.begin(), removed_budgets.end());

        const auto removed_categories =
            std::ranges::remove_if(categories_, [category_id](const auto &entry) { return entry.id == category_id; });
        categories_.erase(removed_categories.begin(), removed_categories.end());
        return {};
    }

    [[nodiscard]]
    budget::types::item_id create_item(std::string_view name, budget::types::category_id category_id,
                                       budget::types::amount amount)
    {
        const auto new_item_id = item_id_ + 1;

        const auto item = budget::types::item{
            .id = new_item_id,
            .category_id = category_id,
            .name = std::string{name},
            .expected = amount,
        };

        items_.push_back(item);

        item_id_ = new_item_id;
        return item_id_;
    }

    budget::types::transaction_id create_transaction(
        std::string_view description, budget::types::transaction_type type, budget::types::amount amount,
        budget::types::date timestamp, std::optional<budget::types::category_id> category_id = std::nullopt,
        std::optional<budget::types::item_id> item_id = std::nullopt)
    {
        const auto new_transaction_id = transaction_id_ + 1;

        auto transaction = budget::types::transaction{
            .id = new_transaction_id,
            .category_id = category_id,
            .item_id = item_id,
            .type = type,
            .description = std::string{description},
            .amount = amount,
            .timestamp = timestamp,
        };

        transactions_.push_back(transaction);

        transaction_id_ = new_transaction_id;
        return transaction_id_;
    }

    [[nodiscard]]
    budget::types::period period() const
    {
        return period_;
    }

    [[nodiscard]]
    std::vector<budget::types::category> categories() const
    {
        return categories_;
    }


    [[nodiscard]]
    std::vector<budget::types::category_budget> category_budgets() const
    {
        return category_budgets_;
    }

    [[nodiscard]]
    std::vector<budget::types::item> items() const
    {
        return items_;
    }

    [[nodiscard]]
    std::vector<budget::types::transaction> transactions() const
    {
        return transactions_;
    }

  private:
    budget::types::category_id category_id_{};
    budget::types::item_id item_id_{};
    budget::types::transaction_id transaction_id_{};

    budget::types::period period_;
    std::vector<budget::types::category> categories_;
    std::vector<budget::types::category_budget> category_budgets_;
    std::vector<budget::types::item> items_;
    std::vector<budget::types::transaction> transactions_;
};
} // namespace budget
