module;

#include <algorithm>
#include <chrono>
#include <iostream>
#include <optional>
#include <string>

#include <CLI/CLI.hpp>

export module budget.cli:month;

import budget.application;
import :month_value;

export namespace budget::cli::month
{
struct month_options
{
    std::string date;
    bool force{};
    std::string from;
    std::string to;
    int exit_code{};
};

void add_month_commands(CLI::App &app, month_options &command_options, budget::application::book_repository &repository)
{
    auto *month_command = app.add_subcommand("month", "Manage budget months");

    auto *new_command = month_command->add_subcommand("new", "Make a new budget month");
    new_command->add_option("date", command_options.date, "Month in YYYY-MM format");
    new_command->add_flag("--force", command_options.force, "Reset the month if it already exists");

    auto *list_command = month_command->add_subcommand("list", "List budget months");
    list_command->add_option("--from", command_options.from, "First month to include in YYYY-MM format");
    list_command->add_option("--to", command_options.to, "Last month to include in YYYY-MM format");

    new_command->callback([&command_options, &repository] {
        using namespace std::chrono;

        year_month requested_month;
        if (command_options.date.empty())
        {
            const auto local = current_zone()->to_local(system_clock::now());
            const year_month_day today{floor<days>(local)};
            requested_month = today.year() / today.month();
        }
        else
        {
            const auto parsed_month = budget::cli::month_value::parse(command_options.date);
            if (!parsed_month)
            {
                std::cerr << "Invalid month '" << command_options.date << "'. Expected a valid YYYY-MM month.\n";
                command_options.exit_code = 2;
                return;
            }

            requested_month = *parsed_month;
        }

        const auto result = budget::application::create_month(
            repository, {.year_month = requested_month, .force = command_options.force});

        const auto formatted_month = budget::cli::month_value::format(requested_month);

        if (!result)
        {
            switch (result.error())
            {
            case budget::application::create_month_error::already_exists: {
                std::cerr << "Budget month " << formatted_month << " already exists. Use --force to reset it.\n";
                command_options.exit_code = 1;
                return;
            }
            case budget::application::create_month_error::missing_month: {
                std::cerr << "A month must be provided.\n";
                command_options.exit_code = 2;
                return;
            }
            }
        }

        switch (*result)
        {
        case budget::application::create_month_result::created: {
            std::cout << "Created budget month " << formatted_month << ".\n";
            break;
        }
        case budget::application::create_month_result::reset: {
            std::cout << "Reset budget month " << formatted_month << ".\n";
            break;
        }
        }
    });

    list_command->callback([&command_options, &repository] {
        using namespace std::chrono;

        std::optional<year_month> from;
        if (!command_options.from.empty())
        {
            from = budget::cli::month_value::parse(command_options.from);
            if (!from)
            {
                std::cerr << "Invalid month '" << command_options.from << "'. Expected a valid YYYY-MM month.\n";
                command_options.exit_code = 2;
                return;
            }
        }

        std::optional<year_month> to;
        if (!command_options.to.empty())
        {
            to = budget::cli::month_value::parse(command_options.to);
            if (!to)
            {
                std::cerr << "Invalid month '" << command_options.to << "'. Expected a valid YYYY-MM month.\n";
                command_options.exit_code = 2;
                return;
            }
        }

        const auto response = budget::application::list_months(repository, {.from = from, .to = to});
        if (!response)
        {
            switch (response.error())
            {
            case budget::application::list_months_error::from_after_to: {
                std::cerr << "The --from month must not be after the --to month.\n";
                command_options.exit_code = 2;
                return;
            }
            }
        }

        const auto &months = *response;
        if (months.empty())
        {
            std::cout << "No budget months found.\n";
            return;
        }

        std::ranges::for_each(months, [](const auto &month) {
            std::cout << budget::cli::month_value::format(month.period().year_month) << '\n';
        });
    });
}
} // namespace budget::cli::month
